# Reverse proxy de la API en el VPS.
#
# Caddy obtiene y renueva el certificado TLS de Let's Encrypt automáticamente,
# por lo que no hay bloque de certificados ni redirección HTTP→HTTPS explícita:
# ambas cosas son el comportamiento por defecto.
#
# El contenedor de la API publica 127.0.0.1:8000 (ver docker-compose.yml), así
# que solo es alcanzable desde el propio host: Caddy es la única vía de entrada
# desde internet.
#
# Instalación en el servidor:
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy

api.pitchlens.es {
    header {
        # Obliga al navegador a usar HTTPS durante un año. Caddy ya redirige
        # HTTP→HTTPS, pero eso no cubre la primera petición en claro, que es
        # justo la interceptable.
        #
        # Sin "preload" de forma deliberada: entrar en la lista precargada de
        # los navegadores es fácil y salir lleva meses, así que no se activa
        # sin quererlo explícitamente.
        Strict-Transport-Security "max-age=31536000; includeSubDomains"

        # La API solo devuelve JSON: nada debe reinterpretarse como otro tipo.
        X-Content-Type-Options "nosniff"

        # No filtrar la URL completa al navegar a otros orígenes.
        Referrer-Policy "strict-origin-when-cross-origin"

        # Caddy y uvicorn anuncian versión; quitarlo no para a nadie, pero
        # tampoco hay motivo para regalar el dato.
        -Server
    }

    reverse_proxy localhost:8000 {
        # Reescribe X-Forwarded-For con la IP de origen en lugar de añadirla al
        # final de lo que mande el cliente. Por defecto Caddy conserva lo que
        # venga y concatena, de modo que quien llama puede colocar entradas
        # falsas por delante. La API ya se defiende leyendo la última entrada
        # (ver src/api/rate_limit.py), pero así la cabecera solo lleva un valor
        # y no hay ambigüedad posible en lo que ve la aplicación.
        header_up X-Forwarded-For {remote_host}
    }
}
