# Plantilla de configuración — copia a .env y rellena los valores.
#   cp .env.example .env

# Contraseña de PostgreSQL. docker-compose.yml la lee de aquí, tanto para
# inicializar el contenedor de la BD como para construir la DATABASE_URL de
# la API. En desarrollo vale cualquier valor; en despliegue, genera una
# aleatoria y que no se parezca a esta:
#   openssl rand -hex 20
POSTGRES_PASSWORD=kraken

# Conexión a PostgreSQL (ver docker-compose.yml para un Postgres local).
# La contraseña debe coincidir con POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg2://kraken:kraken@localhost:5432/pitchlens

# Entorno: "development" activa el echo de SQL en SQLAlchemy; usa "production"
# para silenciarlo en despliegue.
ENV=development

# Orígenes permitidos por CORS (frontend Vite en local por defecto)
CORS_ORIGINS=["http://localhost:5173"]

# Clave secreta para firmar los JWT — genera una aleatoria y NUNCA la commitees.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=changeme-genera-una-clave-aleatoria-larga
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Máximo de modelos custom activos por usuario (se borra el más antiguo al superarlo)
MAX_CUSTOM_MODELS=5

# Entrenamientos simultáneos en todo el servidor, sumando usuarios. Corren en el
# proceso de la API: por encima de los núcleos disponibles se estorban entre sí y
# la API deja de responder. Ajustar al tamaño de la máquina.
MAX_CONCURRENT_TRAININGS=2
